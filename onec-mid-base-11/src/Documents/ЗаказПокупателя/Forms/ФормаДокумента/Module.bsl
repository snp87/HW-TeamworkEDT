#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	// НачалоДорабоки. Попов. ДЗ_КоманднаяРаботаЕДТ. 24.11.2026
	// Расчет скидки с учетом скидки из шапки документа и строки табличной части. При введенной скидке более 100% осуществляется
	// пересчет со скидкой 100%, при этом Пользователю выводится соответствующее уведомление
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	КоэффициентОбщейСкидки = 1 - (ТекущиеДанные.Скидка + Объект.ДЗ_СогласованнаяСкидка) / 100;
	
	Если КоэффициентОбщейСкидки < 0 Тогда
		КоэффициентОбщейСкидки = 0;
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = СтрШаблон("Для ""%1"" применена максимальная скидка 100%% (совокупная выбранная скидка превышает 100%%)", 
		ТекущиеДанные.Номенклатура);
		Сообщение.Сообщить();
	КонецЕсли;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентОбщейСкидки;
	// КонецДорабоки. Попов. ДЗ_КоманднаяРаботаЕДТ. 24.11.2026
	
	РассчитатьСуммуДокумента();

	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПересчитатьТаблицуПриИзмененииСкидки()
	
	// НачалоДоработки. Попов. ДЗ_КоманднаяРаботаЕДТ. 24.11.2026
	// Вопрос пользователю о необходимости пересчета суммы с учетом скидки
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = Ждать ВопросАсинх("Пересчитать таблицу с учетом скидки?", РежимДиалогаВопрос.ДаНет);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПересчитатьСтрокиТЧ();
	КонецЕсли;
	// КонецДорабоки. Попов. ДЗ_КоманднаяРаботаЕДТ. 24.11.2026
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокиТЧ()
	
	// НачалоДоработки. Попов. ДЗ_КоманднаяРаботаЕДТ. 24.11.2026
	// Алгоритм пересчета суммы с учетом скидки в ТЧ Товары и Услуги
	Для Каждого СтрокаТЧ из Объект.Товары Цикл
		РассчитатьСуммуСтроки(СтрокаТЧ);
	КонецЦикла;
	
	Для Каждого СтрокаТЧ из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(СтрокаТЧ);
	КонецЦикла;
	// КонецДорабоки. Попов. ДЗ_КоманднаяРаботаЕДТ. 24.11.2026
	
КонецПроцедуры


